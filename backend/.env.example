# Copiar este archivo como ".env" (en esta misma carpeta) y completar.
# El .env no se sube al repositorio.

# Proveedor para leer facturas: gemini (pruebas, gratis) o claude (producción)
EXTRACCION_PROVEEDOR=gemini

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic (cuando se pase a Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional: forzar un modelo (por defecto gemini-3.8-flash / claude-sonnet-5-5)
# EXTRACCION_MODELO=
