# Copiar este archivo como ".env" (en esta misma carpeta) y completar.
# El .env no se sube al repositorio.

# Proveedor para leer facturas: gemini (pruebas, gratis) o claude (producción)
EXTRACCION_PROVEEDOR=gemini

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic (cuando se pase a Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional: forzar un modelo (por defecto gemini-3.5-flash / claude-sonnet-5-5)
# EXTRACCION_MODELO=

# --- Publicación en internet (opcional; en una PC local no hace falta nada de esto) ---

# Contraseña de acceso al sistema. Si se deja vacía, el acceso es libre (uso local).
# Con una contraseña, todos los endpoints piden iniciar sesión.
ACCESS_PASSWORD=
# Texto largo al azar para firmar la sesión (obligatorio si hay ACCESS_PASSWORD). Generar uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# URL donde se publica el frontend (sin barra final); varias, separadas por coma.
# Por defecto: http://localhost:3000
# CORS_ORIGINS=https://app.tuempresa.com

# Máximo de facturas por hora y por IP que se mandan a la IA (por defecto 100).
# LIMITE_FACTURAS_HORA=100
